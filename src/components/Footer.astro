---
import site, { withBase } from '../lib/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-surface-2/60">
  <div class="container-page py-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href={withBase('/')} class="flex items-center gap-2.5">
          <span
            class="grid size-8 place-items-center rounded-sm bg-seal text-white"
          >
            <Icon name="sparkles" size={16} />
          </span>
          <span class="font-bold text-ink">{site.site.title}</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-ink-mute">{site.site.tagline}</p>
      </div>

      <div class="flex flex-wrap gap-x-10 gap-y-6">
        <div>
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-mute">导航</h3>
          <ul class="space-y-2">
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={withBase(item.url)}
                    class="text-sm text-ink-soft transition-colors hover:text-brand"
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-mute">找到我</h3>
          <ul class="space-y-2">
            {
              site.social.map((item) => (
                <li>
                  <a
                    href={item.url}
                    target={item.url.startsWith('http') ? '_blank' : undefined}
                    rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="inline-flex items-center gap-2 text-sm text-ink-soft transition-colors hover:text-brand"
                  >
                    <Icon name={item.icon} size={14} />
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="my-8 divider-gradient"></div>

    <div
      class="flex flex-col items-center justify-between gap-3 text-xs text-ink-mute sm:flex-row"
    >
      <p>
        © {year} {site.footer.copyright}. 保留所有权利。
      </p>
      <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
        {site.footer.icp && <span>{site.footer.icp}</span>}
        <span class="inline-flex items-center gap-1.5">
          由
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-brand-text transition-colors hover:text-brand"
          >
            Astro
          </a>
          驱动
        </span>
      </p>
    </div>
  </div>
</footer>
