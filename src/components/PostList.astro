---
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/site';

export interface Post {
  id: string;
  data: {
    title: string;
    description?: string;
    pubDate: Date;
    tags?: string[];
    category?: string;
    cover?: string;
    featured?: boolean;
  };
  readingMinutes?: number;
}

export interface Props {
  posts: Post[];
}

const { posts } = Astro.props as Props;

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
const allCategories = [...new Set(posts.map((p) => p.data.category ?? 'note'))];
const categoryLabels: Record<string, string> = { tech: '技术', life: '生活', note: '随笔' };
---

<section class="pb-20" id="post-list">
  <div class="container-page">
    <div class="mb-8">
      <div>
        <!-- 这两个元素直接压在视频上（外面没有面板），必须自带纸色底 -->
        <h2 class="paper-plate text-2xl font-bold tracking-tight text-ink sm:text-3xl">最新文章</h2>
        <p class="paper-plate mt-1.5 text-sm text-ink-mute">共 {posts.length} 篇，按发布时间倒序排列</p>
      </div>

      <!-- 筛选器：分类与标签分两行，放在标题【下面】而不是右侧。
           放右侧时它和标题抢视线，用户反馈「不和谐」；独立成行后标题自成一段，
           筛选器退到次要层级，符合「先读标题、再选条件」的阅读顺序。

           为什么要分两行：分类与标签本来是【两个维度】——分类每篇只能一个
           （tech/life/note），标签一篇可以有多个。原来挤成一行时只有前缀 # 区分，
           看起来像一组重复项（数据上「生活」和「#生活」确实筛出同一篇）。

           外套一层工具栏面板是必需的：行首组名是纯文字，
           直接压在视频上时暗部对比度只有约 3:1（上一轮筛选按钮踩过的坑）。 -->
      <div class="filter-panel mt-5" id="post-filters">
        <div class="filter-row">
          <span class="filter-label">分类</span>
          <button type="button" data-filter="all" class="filter-btn btn btn-sm is-active">
            全部
          </button>
          {
            allCategories.map((c) => (
              <button type="button" data-filter={c} class="filter-btn btn btn-sm">
                {categoryLabels[c] ?? c}
              </button>
            ))
          }
        </div>
        <div class="filter-row">
          <span class="filter-label">标签</span>
          {
            allTags.slice(0, 4).map((t) => (
              <button type="button" data-filter={`tag:${t}`} class="filter-btn btn btn-sm">
                #{t}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="post-grid">
      {
        posts.map((post, i) => (
          <div
            class="reveal h-full"
            data-category={post.data.category ?? 'note'}
            data-tags={(post.data.tags ?? []).join(',')}
            style={`animation-delay: ${Math.min(i * 70, 560)}ms`}
          >
            <PostCard post={post} index={i} />
          </div>
        ))
      }
    </div>

    <p id="empty-hint" class="hidden py-16 text-center text-ink-mute">
      <span class="mb-3 block text-3xl">🍃</span>
      这个分类下还没有文章
    </p>

    <div class="mt-10 flex justify-center">
      <a href={withBase('/archive')} class="btn btn-ghost">
        查看完整归档
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </div>
</section>

<script>
  const grid = document.getElementById('post-grid');
  const emptyHint = document.getElementById('empty-hint');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  const applyFilter = (filter: string) => {
    if (!grid) return;
    let visible = 0;
    grid.querySelectorAll<HTMLElement>('[data-category]').forEach((el) => {
      const category = el.dataset.category ?? '';
      const tags = (el.dataset.tags ?? '').split(',').filter(Boolean);
      let show = true;
      if (filter.startsWith('tag:')) {
        show = tags.includes(filter.slice(4));
      } else if (filter !== 'all') {
        show = category === filter;
      }
      el.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    emptyHint?.classList.toggle('hidden', visible > 0);
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      applyFilter(btn.dataset.filter ?? 'all');
    });
  });
</script>
