---
import '../styles/global.css';
import site, { withBase } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import LoadingScript from '../components/LoadingScript.astro';

export interface Props {
  title?: string;
  description?: string;
  /** 文章页传入，用于 OG 的 article 类型 */
  type?: 'website' | 'article';
  pubDate?: Date;
  tags?: string[];
  cover?: string;
  /** 是否显示页脚上方的“返回顶部” */
  showBackToTop?: boolean;
}

const {
  title,
  description = site.site.description,
  type = 'website',
  pubDate,
  tags = [],
  cover,
  showBackToTop = true,
} = Astro.props as Props;

const pageTitle = title ? `${title} · ${site.site.title}` : site.site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = cover
  ? new URL(withBase(cover), Astro.site ?? Astro.url.origin).href
  : new URL(withBase('/og-default.jpg'), Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang={site.site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.site.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

    <link rel="alternate" type="application/rss+xml" title={site.site.title} href={withBase('/rss.xml')} />

    <ThemeScript />
    <LoadingScript />
  </head>

  <body>
    <LoadingScreen />
    <BackgroundVideo />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-white"
    >
      跳到主要内容
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    {
      showBackToTop && (
        <button
          id="back-to-top"
          type="button"
          class="fixed bottom-6 right-6 z-40 grid size-11 translate-y-4 place-items-center rounded-full border border-line bg-surface text-ink-soft opacity-0 shadow-lg transition-all duration-300 hover:border-brand hover:text-brand pointer-events-none"
          aria-label="返回顶部"
          title="返回顶部"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </button>
      )
    }

    <script>
      const btn = document.getElementById('back-to-top');
      if (btn) {
        const onScroll = () => {
          const show = window.scrollY > 500;
          btn.classList.toggle('opacity-0', !show);
          btn.classList.toggle('translate-y-4', !show);
          btn.classList.toggle('pointer-events-none', !show);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
  </body>
</html>
