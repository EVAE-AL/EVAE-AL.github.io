---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getSortedPosts, findNeighbors, findRelated } from '../../lib/posts';
import { categoryOf } from '../../lib/categories';
import site, { formatDate, isoDate, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post.entry);
const cat = categoryOf(post.data.category);

const posts = await getSortedPosts();
const { prev, next } = findNeighbors(posts, post.id);
const related = findRelated(posts, post);

// 只保留 h2 / h3 生成目录
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Your Name' },
  keywords: (post.data.tags ?? []).join(', '),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  cover={post.data.cover}
>
  <!-- 阅读进度条 -->
  <div class="fixed left-0 top-0 z-[60] h-0.5 w-full bg-transparent" aria-hidden="true">
    <div
      id="reading-progress"
      class="h-full w-0 bg-gradient-to-r from-seal-400 via-seal-500 to-seal-600 transition-[width] duration-100"
    >
    </div>
  </div>

  <article class="pb-20 pt-10 sm:pt-14">
    <div class="container-page">
      <!-- 面包屑 -->
      <nav class="paper-plate mb-8 flex items-center gap-2 text-xs text-ink-mute" aria-label="面包屑">
        <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
        <span class="text-line-strong">/</span>
        <a href={withBase('/archive')} class="transition-colors hover:text-brand">归档</a>
        <span class="text-line-strong">/</span>
        <span class="truncate text-ink-soft">{post.data.title}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <!-- 主内容：整列做成半透明宣纸面板。
             只包正文的话，标题浮在视频上、正文突然开始一块纸，接缝会很生硬 -->
        <div class="paper-panel min-w-0 p-6 sm:p-9 lg:p-11">
          <!-- 文章头部 -->
          <header class="mb-10">
            <div class="mb-5 flex flex-wrap items-center gap-2.5">
              <span class="chip chip-brand">{cat.label}</span>
              {
                (post.data.tags ?? []).map((tag) => (
                  <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)} class="chip">
                    #{tag}
                  </a>
                ))
              }
            </div>

            <h1
              class="text-balance text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl lg:text-[2.75rem]"
            >
              {post.data.title}
            </h1>

            {post.data.description && (
              <p class="mt-5 text-pretty text-lg leading-relaxed text-ink-soft">
                {post.data.description}
              </p>
            )}

            <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-mute">
              <span class="inline-flex items-center gap-1.5">
                <Icon name="calendar" size={14} />
                <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Icon name="clock" size={14} />
                约 {post.readingMinutes} 分钟阅读
              </span>
              {post.data.updatedDate && (
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="tag" size={14} />
                  更新于 {formatDate(post.data.updatedDate)}
                </span>
              )}
            </div>

            <div class="mt-8 divider-gradient"></div>
          </header>

          <!-- 封面 -->
          {
            post.data.cover && (
              <img
                src={withBase(post.data.cover)}
                alt={post.data.title}
                class="mb-10 w-full rounded-2xl border border-line shadow-md"
              />
            )
          }

          <!-- 正文 -->
          <div class="prose-custom">
            <Content />
          </div>

          <div class="mt-14 divider-gradient"></div>

          <!-- 移动端目录 -->
          {
            toc.length > 1 && (
              <details class="card mt-8 p-5 lg:hidden">
                <summary class="cursor-pointer text-sm font-semibold text-ink">本文目录</summary>
                <ul class="mt-4 space-y-2">
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'pl-4' : ''}>
                      <a
                        href={`#${h.slug}`}
                        class="text-sm text-ink-soft transition-colors hover:text-brand"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )
          }

          <!-- 上下篇 -->
          <nav class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="文章导航">
            {
              prev ? (
                <a
                  href={withBase(`/blog/${prev.id}/`)}
                  class="card card-hover group flex flex-col gap-2 p-5"
                >
                  <span class="inline-flex items-center gap-1.5 text-xs text-ink-mute">
                    <Icon name="arrow-left" size={13} />
                    上一篇
                  </span>
                  <span class="font-semibold leading-snug text-ink transition-colors group-hover:text-brand">
                    {prev.data.title}
                  </span>
                </a>
              ) : (
                <div class="hidden sm:block" />
              )
            }
            {
              next && (
                <a
                  href={withBase(`/blog/${next.id}/`)}
                  class="card card-hover group flex flex-col items-end gap-2 p-5 text-right"
                >
                  <span class="inline-flex items-center gap-1.5 text-xs text-ink-mute">
                    下一篇
                    <Icon name="arrow-right" size={13} />
                  </span>
                  <span class="font-semibold leading-snug text-ink transition-colors group-hover:text-brand">
                    {next.data.title}
                  </span>
                </a>
              )
            }
          </nav>
        </div>

        <!-- 侧边栏：桌面端目录 -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-6">
            {
              toc.length > 1 && (
                <div class="card p-5">
                  <h2 class="mb-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink-mute">
                    <Icon name="archive" size={13} />
                    本文目录
                  </h2>
                  <nav id="toc-nav">
                    <ul class="space-y-1.5 border-l border-line">
                      {toc.map((h) => (
                        <li>
                          <a
                            href={`#${h.slug}`}
                            data-toc-link={h.slug}
                            class:list={[
                              'block border-l-2 border-transparent py-1 text-sm leading-snug text-ink-mute transition-all duration-200 hover:text-brand',
                              h.depth === 2 ? '-ml-px pl-3.5' : '-ml-px pl-7 text-[0.82rem]',
                            ]}
                          >
                            {h.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </nav>
                </div>
              )
            }

            <!-- 作者卡片 -->
            <div class="card p-5">
              <div class="flex items-center gap-3">
                <span
                  class="grid size-11 shrink-0 place-items-center rounded-sm bg-seal text-white shadow-sm"
                >
                  <Icon name="user" size={19} />
                </span>
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-ink">{site.author.name}</p>
                  <p class="truncate text-xs text-ink-mute">{site.author.tagline}</p>
                </div>
              </div>
              <div class="mt-4 divider-gradient"></div>
              <a
                href={withBase('/about')}
                class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium text-brand-text transition-colors hover:text-brand"
              >
                了解更多
                <Icon name="arrow-right" size={13} />
              </a>
            </div>
          </div>
        </aside>
      </div>

      <!-- 相关文章 -->
      {
        related.length > 0 && (
          <section class="mt-20">
            <div class="mb-6 flex items-center gap-3">
              <span class="h-px flex-1 bg-gradient-to-r from-transparent to-line" />
              <h2 class="paper-plate text-sm font-semibold uppercase tracking-wider text-ink-mute">
                相关文章
              </h2>
              <span class="h-px flex-1 bg-gradient-to-l from-transparent to-line" />
            </div>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((p, i) => (
                <PostCard post={p} index={i} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script>
    // 阅读进度
    const bar = document.getElementById('reading-progress');
    const onScroll = () => {
      if (!bar) return;
      const height = document.documentElement.scrollHeight - window.innerHeight;
      const progress = height > 0 ? (window.scrollY / height) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    // 目录高亮当前小节
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    const sections = [...links]
      .map((l) => document.getElementById(l.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));

    if (sections.length) {
      const setActive = (id: string) => {
        links.forEach((l) => {
          const active = l.dataset.tocLink === id;
          l.classList.toggle('border-brand', active);
          l.classList.toggle('text-brand', active);
          l.classList.toggle('font-medium', active);
          l.classList.toggle('text-ink-mute', !active);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) setActive(visible[0].target.id);
        },
        { rootMargin: '-96px 0px -70% 0px', threshold: 0 }
      );
      sections.forEach((s) => observer.observe(s));
    }
  </script>
</BaseLayout>
